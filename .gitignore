# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.env
.venv/
venv/
*.egg-info/

# Build artifacts
build/
dist/

# Large CAD binaries (regenerate from scripts)
*.step
*.stl

# PDFs (too large / license unclear)
*.pdf

# Raw data
data/raw/
data/processed/

# Books directory (PDFs)
docs/books/

# Logs (regenerated)
results/logs/

# OS files
.DS_Store
Thumbs.db
*.swp


# Exception: allow project report PDFs
!docs/report/*.pdf
!docs/report/*.PDF
*.AppImage

# OpenFOAM generated files
sim/openfoam/*/constant/polyMesh/
sim/openfoam/*/constant/extendedFeatureEdgeMesh/
sim/openfoam/*/[0-9]*/
sim/openfoam/*/postProcessing/
sim/openfoam/*/log.*
sim/openfoam/*/processor*/
